# =====================================================================
#  Apache: TEMPORARY migration profile — NOT mounted by default.
#
#  Importing a Duplicator / WPvivid package means uploading a multi-GB
#  archive through the browser and then extracting it, which needs limits
#  that are genuinely unsafe to run permanently:
#    - LimitRequestBody 0  : no cap on request size at all
#    - body=0              : no timeout on a slow request body
#  Together those let one client hold a connection open forever while
#  streaming unlimited data — trivial slowloris, trivial disk-fill. That
#  is an acceptable trade for one afternoon of migration; it is not an
#  acceptable production default, which is why this is a separate file
#  instead of the always-mounted one it used to be.
#
#  Everything else (trusted proxy, keep-alive, file-exposure rules) stays
#  in apache/hardening.conf — this file only widens the limits.
#
#  ---------------------------------------------------------------------
#  HOW TO USE (see MIGRATION.md for the full procedure)
#
#  1) Copy it into place:
#       cp apache/migration.conf.example apache/migration.conf
#
#  2) Add the mounts to docker-compose.override.yml (git-ignored):
#       services:
#         wordpress:
#           volumes:
#             - ./apache/migration.conf:/etc/apache2/conf-enabled/zzz-migration.conf:ro
#             - ./php/php.ini.migration.example:/usr/local/etc/php/conf.d/zzz-migration.ini:ro
#
#     The zzz- prefix makes these load AFTER zz-hardening.conf /
#     zz-wordpress.ini, so they win while the override is in place.
#
#  3) docker compose up -d wordpress
#
#  4) WHEN THE MIGRATION IS DONE, remove the override and restart:
#       rm docker-compose.override.yml apache/migration.conf
#       docker compose up -d --force-recreate wordpress
#
#     Confirm you are back on the hardened profile (should NOT be 0):
#       docker compose exec wordpress apachectl -t -D DUMP_RUN_CFG \
#         | grep -i limitrequestbody
# =====================================================================

# Max time Apache waits on a slow request/response (extraction, import).
Timeout 900

# No cap on request body size — backup files can be several GB.
# (PHP's upload_max_filesize / post_max_size still apply.)
LimitRequestBody 0

# mod_reqtimeout aborts "slow" uploads by default. Disable the body
# timeout so multi-GB backup uploads on slow links are not killed.
<IfModule mod_reqtimeout.c>
    RequestReadTimeout header=20-40,MinRate=500 body=0
</IfModule>
